# ============================================================
#  PCM System — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores
# ============================================================

# --- Banco de dados (Supabase ou qualquer PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/pcm_db

# --- Segurança JWT ---
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- E-mail (Gmail recomendado) ---
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-gmail
MAIL_FROM=seu-email@gmail.com
MAIL_FROM_NAME=PCM Sistema de Manutenção
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# --- App ---
APP_NAME=PCM - Controle de Manutenção
FRONTEND_URL=http://localhost:8000
